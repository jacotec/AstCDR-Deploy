# Secrets for ${ENV} interpolation in config.yaml.
# Copy to .env and fill in. .env does NOT belong in version control.

# Host port of the web UI (Docker port mapping, default 3000, bind 0.0.0.0).
# The (TLS) reverse proxy talks to this port.
WEB_PORT=3000

# IP address(es) of your reverse proxy, so that logs and the audit log show the real
# client address from X-Forwarded-For instead of the proxy's. Comma-separated, networks
# allowed (e.g. 10.32.0.1 or 192.168.1.0/24). Only list your proxy: whoever is trusted
# here can claim any client address. Default: 127.0.0.1 (proxy on the same host).
# FORWARDED_ALLOW_IPS=127.0.0.1

# Operator panel (licensed version): FreePBX voicemail directory on this host, mounted
# read-only into the web container. Only change it if your PBX stores voicemail elsewhere.
# VOICEMAIL_DIR=/var/spool/asterisk/voicemail

# Call recordings (licensed version): directory on this host, mounted into the web
# container — read-only by default. Set RECORDINGS_MOUNT=rw to allow deleting recordings
# from AstCDR (still needs the right per role). ASTERISK_GID = group id of `asterisk`
# (`getent group asterisk`), which owns the recordings; FreePBX usually uses 995.
# RECORDINGS_DIR=/var/spool/asterisk/monitor
# RECORDINGS_MOUNT=ro
# ASTERISK_GID=995

# Optional: pin a fixed image version (default is :latest -> auto-updates on pull).
# CDRJ_IMAGE=ghcr.io/jacotec/astcdr:1.0.0

# Session signature (e.g. `openssl rand -hex 32`)
APP_SECRET_KEY=

# FreePBX source (read-only user, see QUICKSTART.md step 1)
SOURCE_DB_PASSWORD=

# Postgres cache (runs locally, reachable on 127.0.0.1 only)
CACHE_DB_PASSWORD=
# Only if port 5432 is already taken on this host — the compose and config.yaml
# both follow this value. Leave empty for the default 5432.
# CACHE_DB_PORT=5432
# Timezone of the Postgres container — makes its logs and a manual `psql` answer in
# local time instead of UTC (a container does NOT inherit the host timezone). Should
# match `app.timezone` in config.yaml; the web/ingest containers derive theirs from
# there automatically. Leave empty for Europe/Berlin.
# TZ=Europe/Berlin

# OIDC (Authentik/Keycloak/Nextcloud)
OIDC_CLIENT_SECRET=

# SMTP for warning emails (optional — only needed if you enable the `email` block in
# config.yaml). Leave BOTH empty for relays that don't require authentication.
SMTP_USER=
SMTP_PASS=

# Codec & media capture (optional — only if you enable the `ami` block in config.yaml).
# Password of the AMI user you created in FreePBX (Settings -> Asterisk Manager Users).
AMI_PASSWORD=

# Break-glass local admin: do NOT put the bcrypt hash here!
# bcrypt hashes contain '$', which Docker Compose interprets as variables in .env
# and destroys the hash. Put the hash RAW into config.yaml instead, under
# auth.local.users[].password_hash.
# Generate:  docker compose run --rm cdrj-web python -m app.auth.local "mypassword"
